# Optional exact HTTPS origin for local port forwarding (no trailing slash).
# Set in .env.local and restart the development server when the tunnel changes.
BOOKING_PUBLIC_ORIGIN=
# Password recovery also requires a Resend API key and a verified sender.
# Store these in .env.local, never in source control. Restart after changes.
BOOKING_RESEND_API_KEY=
BOOKING_EMAIL_FROM=
# LINK Mobility SMS (server-side only). Set LINK_SMS_ENABLED=false to disable sending.
LINK_SMS_ENABLED=true
LINK_SMS_CLIENT_ID=
LINK_SMS_CLIENT_SECRET=
# Optional override if LINK provides a different OAuth token URL for your account.
LINK_SMS_TOKEN_URL=https://sso.linkmobility.com/auth/realms/CPaaS/protocol/openid-connect/token
# Optional short sender name configured/allowed in LINK.
LINK_SMS_SENDER=Steam
# Optional alternative to client credentials, mainly for testing/temporary tokens.
LINK_SMS_BEARER_TOKEN=

# Cloudflare build environment variables (database identifiers are not secrets).
# Set these in the Worker's build settings before production deployment.
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_DATABASE_NAME=

